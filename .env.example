# ── Image version (Docker Hub tag, e.g. latest, dev, 1.0.0) ──
OBLIDESK_VERSION=latest

# ── Database ──
# If using the built-in postgres container (docker-compose.yml):
DB_PASSWORD=changeme

# If using an external PostgreSQL (docker-compose.external-db.yml):
# DATABASE_URL=postgres://oblidesk:yourpassword@your-db-host:5432/oblidesk

# ── Server ──
NODE_ENV=production
SESSION_SECRET=change-this-to-a-random-secret

# ── Client origin (for CORS — set to your actual URL) ──
CLIENT_ORIGIN=http://localhost
LISTEN_PORT=3004

# ── App name (branding + prefix in notification messages) ──
APP_NAME=Oblidesk

# ── Default admin (created on first run) ──
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin123

# ── Encryption key (AES-256, 64 hex characters) ──
# Encrypts stored secrets at rest: inbound mailbox passwords / OAuth tokens,
# outbound SMTP credentials, webhook signing keys.
# Generate once:  openssl rand -hex 32
# WARNING: changing or losing this key makes every stored secret unreadable.
ENCRYPTION_KEY=

# ── Custom directory (attachment blob store — persists across updates) ──
# Mounted at /custom inside the server container.
# Attachments land in /custom/attachments/<tenant_id>/<yyyy>/<mm>/<sha256[0:2]>/<sha256>
# Default: ./custom (next to your docker-compose.yml)
# Unraid example: CUSTOM_DIR=/mnt/user/appdata/oblidesk/custom
# CUSTOM_DIR=./custom

# ── Donnees de demonstration (developpement) ──
# Etat souhaite, pas une action : reconcilie a chaque demarrage.
#   true  -> un tenant "demo" existe et est peuple de tickets realistes
#   false -> ce tenant est supprime
# La purge ne touche QUE le tenant de slug "demo" portant le marqueur pose par
# Oblidesk lui-meme. Un vrai workspace nomme "demo" est laisse intact et signale.
# DEMO_DATA=false
# DEMO_VOLUME=60
